# .env.example — Copy this to .env and fill in your values.
# The actual .env file is git-ignored. Never commit .env.

# ── Price Monitor ──────────────────────────────────────────────────────────────
# How often (seconds) to poll live price data
POLL_INTERVAL_SECONDS=60

# Rolling window size in minutes to compute % change
WINDOW_MINUTES=5

# Alert threshold: flag an event when |% change| over the window >= this value
ANOMALY_THRESHOLD_PERCENT=0.5

# Symbols to monitor (yfinance tickers), comma-separated
WATCH_SYMBOLS=^NSEI,^BSESN

# After an event fires, ignore further events for this symbol for N minutes.
# Prevents dozens of duplicate alerts during a sustained trend.
# EVENT_COOLDOWN_MINUTES=15

# Max events per symbol per backtest run that trigger a news API call.
# Protects the free-tier 100 req/day quota on runaway low-threshold scans.
# Set to 0 to disable (unlimited).
# BACKTEST_MAX_EVENTS_PER_RUN=10

# ── News Ingestion ────────────────────────────────────────────────────────────
# How many minutes before/after the event to search for news
# NEWS_TIME_WINDOW_MINUTES=30

# Maximum articles to retrieve per event
# NEWS_MAX_ARTICLES=50

# Minimum relevance score to pass an article downstream.
# 1.0 = at least one general market keyword; 3.0 = must name Nifty/Sensex/NSE/BSE
# NEWS_RELEVANCE_MIN_SCORE=2.0

# Your NewsAPI.org free-tier key  (https://newsapi.org/register)
NEWSAPI_KEY=your_newsapi_key_here

# ── Causal Context (Rule-Based, no LLM required) ──────────────────────────────
# How many articles to pass through the scoring pipeline (default: 7)
# CAUSAL_TOP_N_ARTICLES=7
# How many ranked articles to display in the output (default: 5)
# CAUSAL_TOP_N_DISPLAY=5

# ── Email Notification ────────────────────────────────────────────────────────
# Pass --notify (live send) or --notify-dry-run (print only) on the CLI.
# Credentials are read from environment variables only — never hardcoded.
#
# Gmail quick-start:
#   1. Enable 2-Step Verification on your Google account.
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create an App Password (select "Mail" + your device).
#   4. Paste the 16-character password as SMTP_PASSWORD below.
#   5. Set SMTP_USER to your full Gmail address.

# SMTP server (default: smtp.gmail.com — works for Gmail App Passwords)
SMTP_HOST=smtp.gmail.com

# SMTP STARTTLS port (default: 587)
SMTP_PORT=587

# Your Gmail address (or any SMTP login username)
SMTP_USER=your_email@gmail.com

# Gmail App Password (16 chars, no spaces) — NOT your regular Gmail password
SMTP_PASSWORD=your_16char_app_password_here

# Sender shown in the From header (leave blank to use SMTP_USER)
EMAIL_FROM=your_email@gmail.com

# Comma-separated list of recipient addresses
EMAIL_TO=recipient@example.com
